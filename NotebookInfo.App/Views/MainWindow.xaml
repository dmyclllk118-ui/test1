<Window x:Class="NotebookInfo.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotebookInfo" Height="820" Width="1080" MinHeight="700" MinWidth="920"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,24">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="NotebookInfo" FontSize="34" FontWeight="Bold" />
                    <TextBlock Text="Best-effort Windows notebook hardware detection" Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Scan" Command="{Binding ScanCommand}" Padding="22,10" Margin="0,0,8,0" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" />
                    <Button Content="Export JSON" Padding="18,10" IsEnabled="False" Margin="0,0,8,0" />
                    <Button Content="Export CSV" Padding="18,10" IsEnabled="False" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Computer" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="Manufacturer" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Computer.Manufacturer}" FontSize="16" Margin="0,0,0,8" />
                            <TextBlock Text="Model" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Computer.Model}" FontSize="16" Margin="0,0,0,8" />
                            <TextBlock Text="Serial Number" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Computer.SerialNumber}" FontSize="16" Margin="0,0,0,8" />
                            <TextBlock Text="BIOS Version" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Computer.BIOSVersion}" FontSize="16" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsControl ItemsSource="{Binding Cpus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="CPU Name" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="16" />
                                                <TextBlock Text="Cores / Threads" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding CoreSummary}" FontSize="16" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Max Clock" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding MaxClockSpeedMHz, StringFormat={}{0} MHz}" FontSize="16" />
                                                <TextBlock Text="Current Clock" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding CurrentClockSpeedMHz, StringFormat={}{0} MHz}" FontSize="16" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Memory" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="Total Memory" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding TotalMemory}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="Memory Modules" Foreground="{StaticResource MutedTextBrush}" />
                            <ItemsControl ItemsSource="{Binding MemoryModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding DisplayCapacity}" /><Run Text=" • " />
                                            <Run Text="{Binding MemoryTypeName}" /><Run Text=" • " />
                                            <Run Text="{Binding ConfiguredClockSpeedMHz}" /><Run Text=" MHz • " />
                                            <Run Text="{Binding Manufacturer}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="GPU" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsControl ItemsSource="{Binding Gpus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="GPU Name" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="16" />
                                                <TextBlock Text="VRAM (WMI estimate)" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding DisplayAdapterRAM}" FontSize="16" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Driver Version" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding DriverVersion}" FontSize="16" />
                                                <TextBlock Text="Resolution / Refresh" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                                                <TextBlock FontSize="16"><Run Text="{Binding DisplayResolution}"/><Run Text=" @ "/><Run Text="{Binding DisplayRefreshRate}"/></TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Display" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsControl ItemsSource="{Binding Displays}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Manufacturer / Model" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock TextWrapping="Wrap" FontSize="16"><Run Text="{Binding ManufacturerCode}"/><Run Text=" "/><Run Text="{Binding Model}"/></TextBlock>
                                                <TextBlock Text="Serial Number" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding SerialNumber}" FontSize="16" />
                                                <TextBlock Text="Physical Size" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding DisplayPhysicalSize}" FontSize="16" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Resolution / Refresh" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock FontSize="16"><Run Text="{Binding DisplayResolution}"/><Run Text=" @ "/><Run Text="{Binding DisplayRefreshRate}"/></TextBlock>
                                                <TextBlock Text="Display Device" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding DeviceString}" TextWrapping="Wrap" FontSize="16" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
